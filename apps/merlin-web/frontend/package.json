{
  "name": "merlin-web-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Local browser operator workspace for Merlin, adapted from the pb2 interface.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node --experimental-strip-types scripts/stage.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/main.tsx src/coverage.tsx scripts/stage.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6.2",
    "vite": "8.2.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1"
}
