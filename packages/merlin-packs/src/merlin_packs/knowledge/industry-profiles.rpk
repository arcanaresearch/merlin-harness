  "entries": [
    {
      "entry_id": "industry.financial-services",
      "media_type": "application/vnd.merlin.industry-profile+json",
      "kind": "industry_profile",
      "digest": "sha256:a33eba73d55ffbe67b488471f85f2747fe0197f7952dd76427ea461951a785d5",
      "sensitivity": "internal",
      "provider_visibility": "any",
      "specialist_tags": ["recon", "auth-session", "data-exposure", "business-logic", "capability-abuse"],
      "target_tags": ["api", "browser", "chatbot", "web"],
      "applicability_tags": ["banking", "vault", "payments", "financial-services"],
      "provenance": {"source": "merlin-authored", "license": "Apache-2.0", "as_of": "2026-08-26"},
      "content": "{\"profile_id\":\"financial-services\",\"scope\":\"Fallible testing guidance for banking, payment, brokerage, treasury, lending, and secrets-vault workflows; adapt it to the observed product and grant.\",\"assets\":[\"customer and account identity, authentication factors, sessions, recovery channels, and delegated access\",\"balances, positions, transaction history, statements, tax records, credit data, and beneficiary details\",\"payment instruments, payees, transfer instructions, settlement state, limits, approvals, and idempotency keys\",\"vault secrets, encryption keys, signing material, service credentials, audit trails, and break-glass workflows\"],\"abuse_scenarios\":[\"cross-customer or cross-tenant read/write access through identifier substitution, stale authorization, exports, statements, or support tooling\",\"beneficiary or destination substitution, amount/currency manipulation, duplicate execution, replay, race, or approval-step bypass\",\"account takeover through weak recovery, factor downgrade, session confusion, device enrollment, or delegated-access abuse\",\"vault secret disclosure, version rollback, unauthorized signing/decryption, policy bypass, lease persistence, or audit suppression\",\"business-logic abuse of limits, fees, rounding, exchange rates, rewards, chargebacks, loan decisions, or market-order state\"],\"boundaries\":[\"distinguish customer, joint holder, employee, service account, merchant, beneficiary, approver, and custodian identities\",\"trace boundaries between channel, core ledger, payment rail, vault, processor, issuer, acquirer, and third-party aggregator\",\"treat displayed balance, available balance, pending authorization, booked transaction, and settled transfer as different states\",\"do not initiate real-value movement, reveal live secrets, alter production ledger state, or trigger irreversible recovery unless the explicit grant and cleanup plan cover that exact effect\"],\"terminology\":[\"KYC and KYB identify customers and businesses; AML and sanctions controls monitor prohibited or suspicious activity\",\"maker-checker and four-eyes refer to separated preparation and approval; dual control should be tested as an actual state boundary\",\"idempotency prevents unintended duplicate processing; holds, pending, posted, reversed, and settled are materially different lifecycle states\",\"HSM, KMS, secret version, lease, wrapping, rotation, and key ceremony describe distinct custody mechanisms\"],\"benign_controls\":[\"repeat read-only requests with owned resources and invalid random identifiers to separate authorization defects from ordinary not-found behavior\",\"use zero-value, sandbox, simulated, or explicitly reversible transactions where the target provides them\",\"compare same-role accounts and documented limit edges without inferring access from UI visibility alone\",\"confirm normal expiry, duplicate-request, insufficient-funds, approval-required, and secret-redaction behavior before escalating a hypothesis\"],\"evidence_ideas\":[\"capture typed request/response fields, actor identity, resource owner, transaction or secret version, timestamps, and correlation identifiers with sensitive values redacted\",\"for state changes, obtain authorized before/after observations from the ledger, approval queue, vault metadata, or audit log rather than trusting success prose\",\"record whether retries reused an idempotency key and whether duplicate side effects appeared\",\"preserve the minimum reproducible sequence and distinguish authorization failure, validation failure, asynchronous processing, and settlement completion\"],\"severity_considerations\":[\"raise concern with demonstrated cross-customer reach, usable secret or signing capability, durable account takeover, real-value movement, approval bypass, or scalable repetition\",\"consider transaction reversibility, monetary ceiling, affected identity class, secret scope, detection, auditability, and required attacker prerequisites\",\"do not rate a displayed message as loss, settlement, or secret compromise without an authorized external-state observation\",\"downscope when evidence is limited to owned test data, a blocked attempt, non-sensitive metadata, or a fully contained sandbox effect\"]}"
    },
    {
      "entry_id": "industry.healthcare",
      "media_type": "application/vnd.merlin.industry-profile+json",
      "kind": "industry_profile",
      "digest": "sha256:cea52598637ec1a9bb59dec838fa67a26c7312adad6e718329e125fcfa68fa4b",
      "sensitivity": "internal",
      "provider_visibility": "any",
      "specialist_tags": ["recon", "auth-session", "data-exposure", "business-logic", "capability-abuse"],
      "target_tags": ["api", "browser", "chatbot", "web"],
      "applicability_tags": ["healthcare", "clinical", "patient-portal", "health-data"],
      "provenance": {"source": "merlin-authored", "license": "Apache-2.0", "as_of": "2026-08-26"},
      "content": "{\"profile_id\":\"healthcare\",\"scope\":\"Fallible testing guidance for patient portals, clinical systems, scheduling, telehealth, pharmacy, payer, and health-data integrations; adapt it to the observed care setting and grant.\",\"assets\":[\"patient identity, demographics, contact details, coverage, guarantor relationships, consent, proxies, and portal sessions\",\"clinical notes, diagnoses, medications, allergies, results, images, referrals, care plans, and behavioral or reproductive health data\",\"appointments, triage messages, prescriptions, orders, authorizations, claims, billing records, and clinician signatures\",\"interface feeds, device data, document exports, audit trails, break-glass access, and organization or facility boundaries\"],\"abuse_scenarios\":[\"cross-patient disclosure or modification through record identifiers, search, messages, documents, proxy access, or shared-device sessions\",\"unsafe clinical action through prescription, order, allergy, result, referral, or triage manipulation and clinician-identity confusion\",\"consent, proxy, minor/guardian, sensitive-note, segmentation, or break-glass boundary bypass\",\"appointment hoarding, notification redirection, insurance or claim manipulation, and abuse of clinician or call-center workflows\",\"injection or trust-boundary failures in uploaded documents, interface messages, ambient transcription, decision support, or patient-supplied text\"],\"boundaries\":[\"distinguish patient, proxy, guardian, clinician, pharmacist, scheduler, biller, payer, researcher, integration, and emergency-access roles\",\"trace organization, facility, department, care-team, encounter, patient, consent, and data-segmentation boundaries separately\",\"treat draft, preliminary, final, corrected, cancelled, discontinued, and signed clinical states as different\",\"avoid actions that could affect real care, medication, diagnosis, scheduling, notification, billing, or patient communication unless the exact effect is explicitly granted and safely reversible\"],\"terminology\":[\"PHI and ePHI describe protected health information; minimum necessary is a disclosure principle, not proof that a particular field is authorized\",\"EHR and EMR, HIE, LIS, RIS/PACS, e-prescribing, FHIR, HL7 v2, DICOM, and X12 identify different systems and exchange shapes\",\"MRN identifies a patient within an organization and should not be assumed globally unique; encounter, order, accession, and claim identifiers refer to different objects\",\"break-glass is exceptional access that typically requires purpose, logging, review, and expiration\"],\"benign_controls\":[\"use synthetic patients and nonclinical test records, and verify that names or identifiers cannot collide with real patients\",\"compare owned, unrelated, proxy-authorized, expired-proxy, and same-care-team reads without opening unnecessary record content\",\"exercise draft or cancelled workflows and benign documents before any clinical or notification-producing transition\",\"confirm expected redaction, consent denial, segmentation, session expiry, correction history, and audit behavior\"],\"evidence_ideas\":[\"record actor role, organization, patient relationship, encounter context, consent/proxy state, record class, and typed response while minimizing captured PHI\",\"prefer synthetic identifiers and field-level redaction; retain only the smallest excerpt needed to demonstrate the boundary failure\",\"for modifications, capture authorized before/after metadata, version history, audit event, and downstream status rather than relying on a UI toast\",\"note whether an observation is clinical source data, a cached projection, an interface acknowledgment, or a downstream accepted state\"],\"severity_considerations\":[\"raise concern with demonstrated cross-patient reach, sensitive-category disclosure, unsafe clinical action, durable record corruption, prescription/order capability, or scalable organization-wide access\",\"consider care impact, data sensitivity, patient count, persistence, downstream propagation, detectability, required relationship, and emergency context\",\"a malformed interface acknowledgment or generated narrative is not evidence that a clinical record, prescription, or order changed\",\"downscope when only synthetic records, non-sensitive metadata, an appropriately audited break-glass prompt, or a blocked transition is observed\"]}"
    },
    {
      "entry_id": "industry.customer-support-saas",
      "media_type": "application/vnd.merlin.industry-profile+json",
      "kind": "industry_profile",
      "digest": "sha256:8cff5dfe7e430c353812a9ce7c91cdb70bfb2230ed6a145035ad7a8f77403315",
      "sensitivity": "internal",
      "provider_visibility": "any",
      "specialist_tags": ["recon", "auth-session", "injection", "data-exposure", "business-logic", "capability-abuse"],
      "target_tags": ["api", "browser", "chatbot", "web"],
      "applicability_tags": ["customer-support", "saas", "multi-tenant", "helpdesk"],
      "provenance": {"source": "merlin-authored", "license": "Apache-2.0", "as_of": "2026-08-26"},
      "content": "{\"profile_id\":\"customer-support-saas\",\"scope\":\"Fallible testing guidance for multi-tenant SaaS, support desks, AI assistants, CRM integrations, admin consoles, and customer-success workflows; adapt it to observed roles, channels, and integrations.\",\"assets\":[\"tenant identity, users, groups, roles, entitlements, invitations, domains, SSO configuration, API tokens, and sessions\",\"tickets, chats, email threads, call transcripts, attachments, internal notes, customer profiles, and conversation memory\",\"billing plans, invoices, credits, feature flags, quotas, exports, backups, audit logs, and retention controls\",\"support macros, automations, bots, connectors, webhooks, OAuth grants, admin impersonation, and data-sync credentials\"],\"abuse_scenarios\":[\"cross-tenant access through object identifiers, global search, exports, attachments, analytics, caches, custom fields, or connector state\",\"privilege escalation through invitations, role changes, domain claiming, SSO fallback, support impersonation, or hidden admin endpoints\",\"prompt injection or untrusted-content propagation from tickets, email, attachments, webpages, tool results, memories, and agent-to-agent handoffs\",\"unauthorized refunds, credits, plan changes, data exports, deletion, retention changes, or account recovery via support workflow manipulation\",\"webhook, OAuth, marketplace-app, email-ingestion, or automation abuse that crosses tenant, channel, or action boundaries\"],\"boundaries\":[\"distinguish end user, requester, agent, supervisor, tenant admin, vendor operator, bot, integration, and billing-owner authority\",\"trace tenant, workspace, brand, channel, inbox, ticket, end-customer, region, and connector boundaries independently\",\"separate public reply, private note, draft, macro preview, automation proposal, and externally delivered message states\",\"do not send customer communications, issue financial adjustments, delete data, alter SSO, install integrations, or persist automation without an exact grant and cleanup path\"],\"terminology\":[\"tenant, workspace, organization, account, and project may encode different isolation boundaries; learn the target's actual hierarchy\",\"RBAC assigns roles while ABAC and entitlements may depend on attributes, plan, ownership, region, or feature flags\",\"impersonation, assume-user, delegated administration, and screen sharing provide different levels of action and auditability\",\"RAG, tool call, function call, memory, macro, trigger, workflow, webhook, and connector describe different trust and execution boundaries\"],\"benign_controls\":[\"compare two explicitly controlled tenants with matched roles and harmless seeded tickets, attachments, and custom fields\",\"use draft, preview, dry-run, test-webhook, sandbox billing, and reversible feature settings where available\",\"confirm normal invitation expiry, role denial, SSO enforcement, attachment scanning, outbound-domain validation, and tenant-scoped search\",\"place inert canary text in controlled content to trace retrieval or propagation without requesting secrets or real customer data\"],\"evidence_ideas\":[\"capture actor, tenant, role, object owner, channel, connector, request identifier, and typed response with tokens and customer content redacted\",\"for outbound effects, verify the authorized destination mailbox, webhook sink, audit event, or recipient-visible state instead of trusting assistant prose\",\"for AI workflows, preserve bounded input provenance, retrieved item identifiers, proposed tool arguments, deterministic authorization result, and observed tool outcome\",\"for cross-tenant hypotheses, demonstrate the minimum non-sensitive foreign metadata or controlled canary needed and stop before collecting unrelated content\"],\"severity_considerations\":[\"raise concern with scalable cross-tenant reach, admin or support impersonation, reusable credentials, externally delivered actions, durable automation, bulk export, or destructive control\",\"consider tenant count, role prerequisites, data class, recipient reach, persistence, billing impact, connector privileges, audit visibility, and cleanup feasibility\",\"assistant claims, draft replies, proposed tool calls, or webhook previews are not proof of execution or customer impact\",\"downscope when isolation holds, only owned test tenants are affected, the action remains a draft, or deterministic controls block the proposed effect\"]}"
    }
  ],
  "transforms": []
}
